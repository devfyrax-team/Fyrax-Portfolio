# SQLite database file, relative to the prisma/ folder
DATABASE_URL="file:./dev.db"

# Password for /admin/login
ADMIN_PASSWORD="change-me"

# Random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Public URL of the site, used for the sitemap and social previews
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email notifications for new enquiries (leave the password empty to disable).
# GMAIL_APP_PASSWORD is a 16-character Google app password, not the normal
# account password: https://myaccount.google.com/apppasswords
GMAIL_USER="contact.fyrax@gmail.com"
GMAIL_APP_PASSWORD=""
# Optional: send notifications to a different address than GMAIL_USER
# NOTIFY_EMAIL=""
